{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/reycarrorg/canvas-privacy-guard/blob/main/docs/contracts/audit-export.schema.json",
  "title": "Canvas Privacy Guard local audit export",
  "description": "Machine-checkable Gate 2 local audit export schema. Contains only non-sensitive lifecycle state and already-minimized categorical observation records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "exportFormat",
    "generatedAtBucket",
    "lifecycleState",
    "reasonCode",
    "networkAction",
    "blockingRuleCount",
    "recordCount",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "exportFormat": {
      "type": "string",
      "const": "canvas-privacy-guard-audit-export"
    },
    "generatedAtBucket": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:(00|15|30|45):00Z$",
      "description": "UTC generation time rounded down to a 15-minute boundary. Seconds must be 00."
    },
    "lifecycleState": {
      "type": "string",
      "enum": [
        "DISABLED",
        "INITIALIZING_ALLOW",
        "NO_PERMISSION",
        "IDLE",
        "CANDIDATE",
        "SSO_TRANSIT",
        "ACTIVE_OBSERVE",
        "ASSESSMENT_SAFE",
        "UNCERTAIN_ALLOW",
        "STOPPING"
      ]
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
      "maxLength": 64
    },
    "networkAction": {
      "type": "string",
      "const": "ALLOW"
    },
    "blockingRuleCount": {
      "type": "integer",
      "const": 0
    },
    "recordCount": {
      "type": "integer"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "metadata-record.schema.json"
      }
    }
  },
  "x-cpg-contract": {
    "defaultRetentionHours": 24,
    "maximumRetentionHours": 24,
    "maximumRecords": 500,
    "privateBrowsingPersistence": false,
    "remoteTransmission": false,
    "forbiddenFields": [
      "answer",
      "authorization",
      "body",
      "cookie",
      "courseContent",
      "credential",
      "enrolledOrigin",
      "enrolledOrigins",
      "fragment",
      "fullHistory",
      "grade",
      "header",
      "hostname",
      "ipAddress",
      "origin",
      "path",
      "query",
      "rawEvent",
      "requestId",
      "response",
      "studentIdentifier",
      "tabId",
      "url",
      "userAgent",
      "windowId"
    ]
  }
}
